      "cell_type": "code",
      "source": [
        "#@title ⚡ 3단계: 저장소 선택 및 메인 실행\n",
        "#@markdown 세션 재시작 후에는 이 블록만 실행해도 복구와 실행이 동시에 됩니다.\n",
        "\n",
        "model_source = \"Google_Drive\" #@param [\"Google_Drive\", \"Local_Colab\"]\n",
        "\n",
        "import os\n",
        "from google.colab import drive\n",
        "\n",
        "# 1. 경로 및 본체 확인\n",
        "DRIVE_PATH = \"/content/drive/MyDrive/ComfyUI\"\n",
        "LOCAL_PATH = \"/content/ComfyUI\"\n",
        "\n",
        "if not os.path.exists(LOCAL_PATH):\n",
        "    !git clone https://github.com/comfyanonymous/ComfyUI\n",
        "    !pip install -r {LOCAL_PATH}/requirements.txt\n",
        "    !pip install insightface onnxruntime-gpu\n",
        "\n",
        "# 2. 모델 지름길 연결 (Source에 따라 변경)\n",
        "model_folders = [\"checkpoints\", \"clip\", \"vae\", \"loras\", \"pulid\", \"insightface\", \"ipadapter\", \"controlnet\"]\n",
        "for folder in model_folders:\n",
        "    l_p, d_p = f\"{LOCAL_PATH}/models/{folder}\", f\"{DRIVE_PATH}/models/{folder}\"\n",
        "    os.makedirs(d_p, exist_ok=True)\n",
        "    if os.path.exists(l_p): !rm -rf {l_p}\n",
        "    if model_source == \"Google_Drive\": !ln -s {d_p} {l_p}\n",
        "    else: os.makedirs(l_p, exist_ok=True)\n",
        "\n",
        "# 3. 커스텀 노드 연결\n",
        "l_n, d_n = f\"{LOCAL_PATH}/custom_nodes\", f\"{DRIVE_PATH}/custom_nodes\"\n",
        "if os.path.exists(l_n): !rm -rf {l_n}\n",
        "!ln -s {d_n} {l_n}\n",
        "\n",
        "# 4. 터널링 및 실행\n",
        "import subprocess, time\n",
        "if os.path.exists(\"/content/tunnel.log\"): os.remove(\"/content/tunnel.log\")\n",
        "subprocess.Popen([\"cloudflared\", \"tunnel\", \"--url\", \"http://127.0.0.1:8188\"], stdout=open(\"/content/tunnel.log\", \"w\"))\n",
        "time.sleep(8)\n",
        "\n",
        "with open(\"/content/tunnel.log\", \"r\") as f:\n",
        "    import re\n",
        "    url = re.findall(r\"https://[a-zA-Z0-9-.]+\\.trycloudflare\\.com\", f.read())\n",
        "    if url: print(f\"\\n🔗 접속 링크: {url[0]}\\n\")\n",
        "\n",
        "%cd {LOCAL_PATH}\n",
        "!python main.py --listen --preview-method auto"
      ],
