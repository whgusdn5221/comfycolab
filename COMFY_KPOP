      "cell_type": "code",
      "source": [
        "#@title 📥 1단계: 모델 선택 다운로드 (로컬 SSD)\n",
        "#@markdown 원하는 모델을 체크하고 실행하세요. (코랩 SSD `/content/ComfyUI/models`에 저장됩니다.)\n",
        "\n",
        "#@markdown ---\n",
        "#@markdown ### **[Qwen-VL 필수 세트]**\n",
        "qwen_checkpoints = True #@param {type:\"boolean\"}\n",
        "qwen_clip_vae = True #@param {type:\"boolean\"}\n",
        "\n",
        "#@markdown ### **[AnyPose LoRA 세트]**\n",
        "anypose_loras = True #@param {type:\"boolean\"}\n",
        "\n",
        "#@markdown ### **[얼굴 고정 PuLID]**\n",
        "pulid_flux = True #@param {type:\"boolean\"}\n",
        "insightface_antelopev2 = True #@param {type:\"boolean\"}\n",
        "#@markdown ---\n",
        "\n",
        "import os\n",
        "\n",
        "MODEL_BASE = \"/content/ComfyUI/models\"\n",
        "os.makedirs(f\"{MODEL_BASE}/checkpoints/qwen\", exist_ok=True)\n",
        "os.makedirs(f\"{MODEL_BASE}/clip/qwen\", exist_ok=True)\n",
        "os.makedirs(f\"{MODEL_BASE}/vae\", exist_ok=True)\n",
        "os.makedirs(f\"{MODEL_BASE}/loras\", exist_ok=True)\n",
        "os.makedirs(f\"{MODEL_BASE}/pulid\", exist_ok=True)\n",
        "os.makedirs(f\"{MODEL_BASE}/insightface/models/antelopev2\", exist_ok=True)\n",
        "\n",
        "def dl(url, path, name):\n",
        "    target = os.path.join(path, name)\n",
        "    if not os.path.exists(target):\n",
        "        print(f\"📥 다운로드 중: {name}\")\n",
        "        !wget -c \"{url}\" -O \"{target}\"\n",
        "    else: print(f\"✅ 이미 있음: {name}\")\n",
        "\n",
        "# Qwen 체크포인트\n",
        "if qwen_checkpoints:\n",
        "    dl(\"https://huggingface.co/Comfy-Org/Qwen-Image-Edit_ComfyUI/resolve/main/split_files/diffusion_models/qwen_image_edit_2511_bf16.safetensors\", f\"{MODEL_BASE}/checkpoints/qwen\", \"qwen_image_edit_2511_bf16.safetensors\")\n",
        "\n",
        "# Qwen CLIP & VAE\n",
        "if qwen_clip_vae:\n",
        "    dl(\"https://huggingface.co/Comfy-Org/HunyuanVideo_1.5_repackaged/resolve/main/split_files/text_encoders/qwen_2.5_vl_7b_fp8_scaled.safetensors\", f\"{MODEL_BASE}/clip/qwen\", \"qwen_2.5_vl_7b_fp8_scaled.safetensors\")\n",
        "    dl(\"https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/vae/qwen_image_vae.safetensors\", f\"{MODEL_BASE}/vae\", \"qwen_image_vae.safetensors\")\n",
        "\n",
        "# AnyPose LoRAs\n",
        "if anypose_loras:\n",
        "    dl(\"https://huggingface.co/lightx2v/Qwen-Image-Edit-2511-Lightning/resolve/main/Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors\", f\"{MODEL_BASE}/loras\", \"Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors\")\n",
        "    dl(\"https://huggingface.co/ShYuan/Qwen2.5-VL-AnyPose/resolve/main/2511-AnyPose-base-000006250.safetensors\", f\"{MODEL_BASE}/loras\", \"2511-AnyPose-base-000006250.safetensors\")\n",
        "    dl(\"https://huggingface.co/ShYuan/Qwen2.5-VL-AnyPose/resolve/main/2511-AnyPose-helper-00006000.safetensors\", f\"{MODEL_BASE}/loras\", \"2511-AnyPose-helper-00006000.safetensors\")\n",
        "\n",
        "# PuLID & Insightface\n",
        "if pulid_flux:\n",
        "    dl(\"https://huggingface.co/guozhihong/PuLID/resolve/main/pulid_flux_v1.safetensors\", f\"{MODEL_BASE}/pulid\", \"pulid_flux_v1.safetensors\")\n",
        "\n",
        "if insightface_antelopev2:\n",
        "    # 대표 파일 1개만 예시 (실제 구동시 insightface 라이브러리가 나머지를 채울 수 있음)\n",
        "    dl(\"https://huggingface.co/comfyanonymous/insightface_models/resolve/main/models/antelopev2/scrfd_10g_bnkps.onnx\", f\"{MODEL_BASE}/insightface/models/antelopev2\", \"scrfd_10g_bnkps.onnx\")\n",
        "\n",
        "print(\"\\n✨ 선택한 모델 다운로드 완료!\")"
      ],
