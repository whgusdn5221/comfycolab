        "#@title 📥 1단계: 모든 핵심 모델 선택 다운로드 (로컬 SSD)\n",
        "#@markdown 원하는 카테고리를 체크하고 실행하세요. `/content/ComfyUI/models`에 직접 저장됩니다.\n",
        "\n",
        "#@markdown ---\n",
        "#@markdown ### **[1] FLUX & Qwen 메인 모델**\n",
        "flux_dev_standard = True #@param {type:\"boolean\"}\n",
        "qwen_vl_edit_set = True #@param {type:\"boolean\"}\n",
        "flux_vae_and_clip = True #@param {type:\"boolean\"}\n",
        "\n",
        "#@markdown ### **[2] IPAdapter & CLIP Vision (이미지 참조 핵심)**\n",
        "ipadapter_flux_plus = True #@param {type:\"boolean\"}\n",
        "clip_vision_vit_h = True #@param {type:\"boolean\"}\n",
        "clip_vision_siglip = True #@param {type:\"boolean\"}\n",
        "\n",
        "#@markdown ### **[3] ControlNet (자세 및 외형 제어)**\n",
        "controlnet_flux_canny = True #@param {type:\"boolean\"}\n",
        "controlnet_flux_depth = True #@param {type:\"boolean\"}\n",
        "\n",
        "#@markdown ### **[4] 얼굴 고정 및 LoRA (PuLID, AnyPose)**\n",
        "pulid_flux_face = True #@param {type:\"boolean\"}\n",
        "insightface_antelopev2 = True #@param {type:\"boolean\"}\n",
        "anypose_lora_set = True #@param {type:\"boolean\"}\n",
        "#@markdown ---\n",
        "\n",
        "import os\n",
        "MODEL_BASE = \"/content/ComfyUI/models\"\n",
        "\n",
        "# 폴더 자동 생성 로직\n",
        "folders = [\"checkpoints/qwen\", \"clip/qwen\", \"vae\", \"loras\", \"pulid\", \"ipadapter\", \"clip_vision\", \"controlnet\", \"insightface/models/antelopev2\"]\n",
        "for f in folders: os.makedirs(f\"{MODEL_BASE}/{f}\", exist_ok=True)\n",
        "\n",
        "def dl(url, path, name):\n",
        "    target = os.path.join(path, name)\n",
        "    if not os.path.exists(target):\n",
        "        print(f\"📥 다운로드 중: {name}...\")\n",
        "        !wget -c \"{url}\" -O \"{target}\"\n",
        "    else: print(f\"✅ 이미 있음: {name}\")\n",
        "\n",
        "# --- 실행 로직 ---\n",
        "if flux_dev_standard:\n",
        "    dl(\"https://huggingface.co/black-forest-labs/FLUX.1-dev/resolve/main/flux1-dev.safetensors\", f\"{MODEL_BASE}/checkpoints\", \"flux1-dev.safetensors\")\n",
        "\n",
        "if qwen_vl_edit_set:\n",
        "    dl(\"https://huggingface.co/Comfy-Org/Qwen-Image-Edit_ComfyUI/resolve/main/split_files/diffusion_models/qwen_image_edit_2511_bf16.safetensors\", f\"{MODEL_BASE}/checkpoints/qwen\", \"qwen_image_edit_2511_bf16.safetensors\")\n",
        "    dl(\"https://huggingface.co/Comfy-Org/Qwen-Image_ComfyUI/resolve/main/split_files/vae/qwen_image_vae.safetensors\", f\"{MODEL_BASE}/vae\", \"qwen_image_vae.safetensors\")\n",
        "\n",
        "if flux_vae_and_clip:\n",
        "    dl(\"https://huggingface.co/black-forest-labs/FLUX.1-dev/resolve/main/ae.safetensors\", f\"{MODEL_BASE}/vae\", \"ae.safetensors\")\n",
        "    dl(\"https://huggingface.co/comfyanonymous/flux_text_encoders/resolve/main/t5xxl_fp8_e4m3fn.safetensors\", f\"{MODEL_BASE}/clip\", \"t5xxl_fp8_e4m3fn.safetensors\")\n",
        "\n",
        "if clip_vision_vit_h:\n",
        "    dl(\"https://huggingface.co/h94/IP-Adapter/resolve/main/models/image_encoder/model.safetensors\", f\"{MODEL_BASE}/clip_vision\", \"CLIP-ViT-H-14-laion2B-s32B-b79K.safetensors\")\n",
        "\n",
        "if ipadapter_flux_plus:\n",
        "    dl(\"https://huggingface.co/InstantX/FLUX.1-dev-IP-Adapter/resolve/main/ip-adapter.bin\", f\"{MODEL_BASE}/ipadapter\", \"flux-ip-adapter.bin\")\n",
        "\n",
        "if pulid_flux_face:\n",
        "    dl(\"https://huggingface.co/guozhihong/PuLID/resolve/main/pulid_flux_v1.safetensors\", f\"{MODEL_BASE}/pulid\", \"pulid_flux_v1.safetensors\")\n",
        "\n",
        "if anypose_lora_set:\n",
        "    dl(\"https://huggingface.co/lightx2v/Qwen-Image-Edit-2511-Lightning/resolve/main/Qwen-Image-Edit-2511-Lightning-4steps-V1.0-bf16.safetensors\", f\"{MODEL_BASE}/loras\", \"Qwen-Image-Edit-Lightning-4steps-V1.0-bf16.safetensors\")\n",
